<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="SOCKS5 proxy (guest apps)">
        <EditTextPreference
                app:key="mSocksHost"
                app:title="Proxy IPv4 address"
                app:defaultValue="127.0.0.1"
                app:useSimpleSummaryProvider="true" />
        <EditTextPreference
                app:key="mSocksPort"
                app:title="Proxy port"
                app:defaultValue="1080"
                app:useSimpleSummaryProvider="true" />
        <EditTextPreference
                app:key="mSocksUser"
                app:title="Username (optional)"
                app:useSimpleSummaryProvider="true" />
        <EditTextPreference
                app:key="mSocksPassword"
                app:title="Password (optional)"
                app:useSimpleSummaryProvider="false"
                android:inputType="textPassword" />
    </PreferenceCategory>



    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />


        <Preference
                app:key="network_diagnostics"
                app:title="@string/network_diagnostics"
                app:summary="@string/network_diagnostics_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />


    </PreferenceCategory>

</PreferenceScreen>
